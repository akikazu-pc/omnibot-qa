# 复制成 .env 后填入真实值；也可以用 npm run kf:setup 自动生成
# .env 已在 .gitignore 里，不会进仓库

# ── 微信客服（对外，外部客户扫码咨询走这里）────────────────
# 企业微信管理后台 → 我的企业 → 企业信息 → 企业ID
KF_CORP_ID=
# 应用管理 → 微信客服 →  Secret（点「查看」，会发到企业微信里）
KF_SECRET=
# 应用管理 → 微信客服 → 接收消息服务器配置 → Token（自己填，字母数字 1-32 位）
KF_TOKEN=
# 同上 → EncodingAESKey（点「随机获取」，43 位）
KF_AES_KEY=

# ── 企业微信智能机器人（对内，给员工用）────────────────────
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# ── 可选 ─────────────────────────────────────────────────
# 关掉自动回复（只记录不回复），调试时有用
AUTO_REPLY=true
# 有 API Key 才走模型兜底；不配就只有「价格页 + 话术库」两层
OPENAI_API_KEY=
